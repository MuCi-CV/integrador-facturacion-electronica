# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — Integrador de Facturación Electrónica
#
# Copiá este archivo a `.env` en la RAÍZ del proyecto (junto a manage.py) y
# completá los valores reales. El `.env` está en .gitignore: NUNCA se commitea.
#
# Carga: settings.py usa `dotenv_values(".env")` con ruta RELATIVA, así que el
# proceso (manage.py / gunicorn) debe ejecutarse desde la raíz del proyecto.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django (OBLIGATORIAS) ────────────────────────────────────────────────────
# settings.py las lee sin default y llama .lower()/.split(): si faltan, rompe.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
# Lista separada por comas, sin espacios.
ALLOWED_HOSTS=integrador.muci.org,localhost,127.0.0.1

# ── Base de datos MySQL (OBLIGATORIAS) ───────────────────────────────────────
DB_NAME=nombre_de_la_base
DB_USER=usuario_db
DB_PASSWORD=password_db
DB_HOST=127.0.0.1
DB_PORT=3306

# ── WooCommerce (OBLIGATORIAS) ───────────────────────────────────────────────
WOOCOMMERCE_URL=https://tu-tienda.com
WOOCOMMERCE_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional (default: true). Poné false solo si el server WooCommerce no valida SSL.
WOOCOMMERCE_VERIFY_SSL=true

# ── BIMS (recomendadas; sin ellas falla el login a BIMS) ─────────────────────
# BIMS_API_KEY: autenticación por header (X-API-Key). La key va CRUDA, sin
#   prefijo de tenant. Se activa en la configuración del usuario en BIMS.
#   Si está seteada, el integrador NO hace login y no usa ?sid=; si está vacía,
#   cae al modo sesión con BIMS_USER/BIMS_PASSWORD/BIMS_TENANT.
#   Vaciarla es el rollback: no requiere redeploy, solo reiniciar el servicio.
#   ⚠️ BIMS corta la autenticación por usuario+password el 30/09/2026.
BIMS_API_KEY=
# OJO: cada tenant vive en UN host. Verificar cuál responde al login/la key
#   antes de fijar BIMS_URL — apuntar al equivocado devuelve 401 permanente.
BIMS_URL=https://bims.app/api
# BIMS_FALLBACK_URL: URL secundaria de BIMS. OPCIONAL — si la primaria agota
#   sus reintentos (o el login no logra conectar), el integrador conmuta
#   automáticamente a esta URL y se queda en ella mientras responda.
#   Dejarla vacía o comentada desactiva la conmutación.
BIMS_FALLBACK_URL=https://in.bims.app/api
BIMS_USER=usuario_api_bims
BIMS_PASSWORD=password_api_bims
BIMS_TENANT=tenant_bims

# ── Cola de facturación (opcional) ───────────────────────────────────────────
# Minutos que el reaper de `process_queue` espera antes de dar por muerta una
# fila que quedó en PROCESSING. Tiene que ser holgadamente mayor que lo que
# tarda una orden en facturarse: si se queda corto, el reaper le roba la fila a
# un worker que todavía está trabajando. Default: 10.
#QUEUE_REAPER_MINUTES=10

# Cuántas filas pendientes hacen falta para avisar a Slack. Default: 10.
#QUEUE_ALERT_THRESHOLD=10

# Minutos que una fila vencida puede quedarse sin avanzar antes de avisar.
# OJO: esto NO detecta que el cron esté muerto — si el cron no corre, el aviso
# tampoco. Para eso hace falta un latido externo. Default: 10.
#QUEUE_SILENCE_MINUTES=10

# Webhook de Slack para los avisos de operación (cola larga, reintentos
# agotados, cola estancada). Si se deja vacío no se avisa a nadie y todo lo
# demás sigue funcionando igual. Sentry queda para bugs de código.
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Consulta de RUC ──────────────────────────────────────────────────────────
# RUC_API_URL: fuente para corregir la razón social por RUC (feature nueva).
#   OPCIONAL — si se omite, settings.py usa por default "https://turuc.com.py".
RUC_API_URL=https://turuc.com.py
# RUC_URL: usado por la función vieja BimsApi.find_razon_social_by_ruc (legado).
#   Opcional; dejar vacío si no se usa.
RUC_URL=

# ── URL base del sitio (para enlaces de recuperación de contraseña) ──────────
# Opcional pero recomendada en producción.
BASE_URL=https://integrador.muci.org

# ── Endpoint /contact-lookup/ (plugin POS de WordPress) ──────────────────────
# Token compartido que autoriza la consulta de contacto por RUC/email desde el
# plugin muci-pos-ruc-autofill. Debe coincidir con MUCI_POS_LOOKUP_TOKEN en el
# wp-config.php del sitio WordPress. Sin él, el endpoint responde 401 siempre.
POS_LOOKUP_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# ── Email (solo se usa cuando DEBUG=False; con DEBUG=True van a consola) ──────
# Todas opcionales (tienen defaults en settings.py).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
</content>

# ── Sincronización de stock BIMS → WooCommerce (opcional) ────────────────────
# Depósitos de BIMS cuyo stock se publica en la web, separados por coma. Medido
# el 2026-09-02: todo el stock está en 6 (San Cosmos) y 7 (GIFTSHOP MOVIL);
# Casa Matriz (1) tiene 0 en todo el catálogo. Default: 6,7
#STOCK_WAREHOUSE_IDS=6,7

# Cuántos productos puede apagar un solo barrido antes de abortar y avisar a
# Slack. Un cero masivo casi siempre es un error de configuración, no que se
# haya vendido todo. Default: 5
#STOCK_ZERO_GUARD=5

# En false el barrido calcula e informa pero NO escribe en WooCommerce.
# ⚠️ Arranca en false a propósito: el primer barrido va en seco. Default: false
#STOCK_SYNC_ENABLED=false

# Tamaño de página contra BIMS. NO subirlo: con 500, la respuesta de
# products?v_stock=1 no entra en los 30 s de timeout de lectura. Default: 100
#STOCK_PAGE_SIZE=100
