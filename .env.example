# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — Integrador de Facturación Electrónica
#
# Copiá este archivo a `.env` en la RAÍZ del proyecto (junto a manage.py) y
# completá los valores reales. El `.env` está en .gitignore: NUNCA se commitea.
#
# Carga: settings.py usa `dotenv_values(".env")` con ruta RELATIVA, así que el
# proceso (manage.py / gunicorn) debe ejecutarse desde la raíz del proyecto.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django (OBLIGATORIAS) ────────────────────────────────────────────────────
# settings.py las lee sin default y llama .lower()/.split(): si faltan, rompe.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
# Lista separada por comas, sin espacios.
ALLOWED_HOSTS=integrador.muci.org,localhost,127.0.0.1

# ── Base de datos MySQL (OBLIGATORIAS) ───────────────────────────────────────
DB_NAME=nombre_de_la_base
DB_USER=usuario_db
DB_PASSWORD=password_db
DB_HOST=127.0.0.1
DB_PORT=3306

# ── WooCommerce (OBLIGATORIAS) ───────────────────────────────────────────────
WOOCOMMERCE_URL=https://tu-tienda.com
WOOCOMMERCE_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional (default: true). Poné false solo si el server WooCommerce no valida SSL.
WOOCOMMERCE_VERIFY_SSL=true

# ── BIMS (recomendadas; sin ellas falla el login a BIMS) ─────────────────────
BIMS_URL=https://bims.app/api
# BIMS_FALLBACK_URL: URL secundaria de BIMS. OPCIONAL — si la primaria agota
#   sus reintentos (o el login no logra conectar), el integrador conmuta
#   automáticamente a esta URL y se queda en ella mientras responda.
#   Dejarla vacía o comentada desactiva la conmutación.
BIMS_FALLBACK_URL=https://in.bims.app/api
BIMS_USER=usuario_api_bims
BIMS_PASSWORD=password_api_bims
BIMS_TENANT=tenant_bims

# ── Consulta de RUC ──────────────────────────────────────────────────────────
# RUC_API_URL: fuente para corregir la razón social por RUC (feature nueva).
#   OPCIONAL — si se omite, settings.py usa por default "https://turuc.com.py".
RUC_API_URL=https://turuc.com.py
# RUC_URL: usado por la función vieja BimsApi.find_razon_social_by_ruc (legado).
#   Opcional; dejar vacío si no se usa.
RUC_URL=

# ── URL base del sitio (para enlaces de recuperación de contraseña) ──────────
# Opcional pero recomendada en producción.
BASE_URL=https://integrador.muci.org

# ── Endpoint /contact-lookup/ (plugin POS de WordPress) ──────────────────────
# Token compartido que autoriza la consulta de contacto por RUC/email desde el
# plugin muci-pos-ruc-autofill. Debe coincidir con MUCI_POS_LOOKUP_TOKEN en el
# wp-config.php del sitio WordPress. Sin él, el endpoint responde 401 siempre.
POS_LOOKUP_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# ── Email (solo se usa cuando DEBUG=False; con DEBUG=True van a consola) ──────
# Todas opcionales (tienen defaults en settings.py).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
</content>
